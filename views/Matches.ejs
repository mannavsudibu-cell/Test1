<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Login/Register</title>
    <link rel="stylesheet" href="/styleMatches.css">
</head>

<body>
    <header class="top-bar">
        <h1 class="app-title">Matches</h1>
        <form style="margin: 0;" action="/Logout" method="post">
            <button class="save-btn" type="submit">Logout</button>
        </form>
    </header>

    <main class="content">

        <div id="loadingIndicator" class="loading-overlay">
            <div class="spinner"></div>
        </div>

        <div id="emptyState" style="display: none;" class="empty-state">
            <div class="empty-icon">:O</div>
            <h3>Sāc meklēt sev jaunu vēstuļu draugu</h3>
            <a href="/Find">Jebkurā brīdī var parādīties!</a>
        </div>
        <div id="matchesContainer" class="matches-container"></div>
    </main>


    <nav class="bottom-nav">
        <a href="/Find" class="nav-item">
            <span class="nav-icon">🔥</span>
            <span class="nav-label">Swipe</span>
        </a>

        <a href="/Matches" class="nav-item active">
            <span class="nav-icon">⭐</span>
            <span class="nav-label">Matches</span>
        </a>

        <a href="/" class="nav-item">
            <span class="nav-icon">👤</span>
            <span class="nav-label">Profile</span>
        </a>
    </nav>

    <script src="/GetMatches.js" type="text/javascript"></script>
</body>