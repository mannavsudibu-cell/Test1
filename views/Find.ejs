<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Login/Register</title>
    <link rel="stylesheet" href="/styleFind.css">
</head>

<body>
    <header class="top-bar">
        <h1 class="app-title">Discover</h1>
        <div class="app-title">
                <button class="report-btn" id="ReportBtn" onclick="SubmitReport()">⚠ Report User</button>
        </div>
    </header>


    <div class="content">
        <div class="card-stack">
            <div id="noMoreUsers" class="no-more" style="display: none;">
                <div class="no-more-icon">🔥</div>
                <h3>Ir beigušies jauni lietotāji</h3>
                <p>Lūdzu atgriežaties vēlāk</p>
            </div>
            <div id="loadingIndicator" class="loading-overlay">
                <div class="spinner"></div>
            </div>

            <div class="card-container" id="Holder">
            </div>

        </div>

        <div class="global-actions">
            <button onclick="SetNextUser()" id="declineBtn" class="action-btn decline">✕</button>
            <button onclick="SetLike(), SetNextUser()" id="likeBtn" class="action-btn like">✚</button>
        </div>
    </div>

    <div id="more-panel" class="more-panel">
        <div class="more-header">
            <h3>Ekstra informācija</h3>
            <button onclick="closeMore()">✕</button>
        </div>

        <div class="more-content">
            <p id="Hobiji"><strong>a: </strong> aa</p>
            <p id="Ambitions"><strong>a: </strong> a</p>
            <p id="Motivation"><strong>a:</strong> a</p>
            <p id="Specialty"><strong>a:</strong> a</p>
            <p id="Descr"><strong>a:</strong> a</p>
        </div>
    </div>

    <div id="matchPopup" class="match-popup">
        <div class="match-box">
            <h2>It's a Match! 🎉</h2>
            <p>You and <span id="matchedName"></span> liked each other.</p>

            <div class="match-buttons">
                <button id="keepSwiping">Keep Swiping</button>
                <button id="goToChat">Go to Matches</button>
            </div>
        </div>
    </div>

    <nav class="bottom-nav">
        <a href="/Find" class="nav-item active">
            <span class="nav-icon">🔥</span>
            <span class="nav-label">Swipe</span>
        </a>

        <a href="/Matches" class="nav-item">
            <% if (User.NewOne) { %>
                <div class="icon-wrapper">
                    <span class="notification-badge">!</span>
                    <i class="fa-solid fa-heart"></i>
                </div>
                <% } %>
                    <span class="nav-icon">⭐</span>
                    <span class="nav-label">Matches</span>
        </a>

        <a href="/" class="nav-item">
            <span class="nav-icon">👤</span>
            <span class="nav-label">Profile</span>
        </a>
    </nav>
    <script src="/Controller.js" type="text/javascript"></script>
</body>